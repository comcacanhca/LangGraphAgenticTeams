# ── Runtime: checkpoint DB, log, Gradle cache ───────────────────────────────
# KHÔNG commit. Checkpoint chứa toàn bộ state của hệ agent.
.runtime/

# ── Kết quả sinh ra ───────────────────────────────────────────────────────
# workspace chứa project do agent tạo. Thiết kế/báo cáo (.html) được
# commit có chủ đích — đó là thứ bạn duyệt ở GATE, mất đi thì mất dấu
# vết quyết định. Source code sinh ra sẽ là git repo riêng, không ở đây.
workspace/*/design.html
workspace/*/report.html
workspace/*/BACKLOG.md
workspace/*/SPRINT.md
workspace/*/LESSONS.md
workspace/*/DEFECTS.json

# KHÔNG commit source do agent sinh — mỗi project là git repo riêng,
# tránh lẫn lịch sử git của hệ thống với lịch sử của app được sinh.
workspace/*/src/
workspace/*/build/
workspace/*/.gradle/
workspace/*/app/

# ── Bảo mật: KHÔNG BAO GIỜ commit ─────────────────────────────────────────
# Keystore lọt vào git = mất khoá app vĩnh viễn, không thu hồi được.
*.jks
*.keystore
local.properties
service_account.json
*.pem
.env
.env.*
!.env.example

# ── Gradle / Android ──────────────────────────────────────────────────────
.gradle/
build/
*.apk
*.aab
captures/

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# ── IDE ───────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml

# ── OS ────────────────────────────────────────────────────────────────────
Thumbs.db
.DS_Store
desktop.ini

# ── Logs ──────────────────────────────────────────────────────────────────
*.log

# ── Kết quả đo độ tin cậy model ─────────────────────────────────────────────
# benchmark.json được commit có chủ đích: đây là bằng chứng đo được để
# quyết định có nên đổi model hay không.
#
# Khi đổi active_profile, đổi tên file kết quả mới thành
# benchmark_<model>.json rồi chạy:
#   agentic benchmark --compare benchmark_<model-cu>.json --out benchmark.json
benchmark*.json

# ── Kết quả chạy tạm ──────────────────────────────────────────────────────
*_out.txt
*_err.txt
*_pid.txt
